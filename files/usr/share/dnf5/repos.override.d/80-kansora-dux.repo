# Kansora: stable Dux builds only.
#
# The Dux COPRs also publish development builds as *-git packages, and
# dux-greeter-git provides dux-greeter at a higher epoch (2: vs 1:), so dnf would
# swap the stable login screen for it on install or update.
#
# An override rather than an edit to the .repo files: it matches every Dux repo
# ID, including the coprdep: one `dnf copr enable` adds, and applies even when a
# repo file was rewritten (which leaves Kansora's update as a .rpmnew).
# To use the development builds anyway, mask this file with an empty
# /etc/dnf/repos.override.d/80-kansora-dux.repo.
[*:copr.fedorainfracloud.org:duxlabs:*]
excludepkgs=*-git,*-git-*
